# Servidor
PORT=3000

# Senhas dos usuários de seed (apenas desenvolvimento)
SEED_ADMIN_SENHA=
SEED_DEFAULT_SENHA=

# Firebase Admin SDK — credenciais do Service Account
# Gerar em: Console Firebase → Configurações do Projeto → Contas de Serviço
# NUNCA commitar o .env com valores reais
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
